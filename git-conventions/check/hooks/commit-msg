#!/bin/sh
# git-conventions commit-msg hook: checks the first non-comment line of the message.
# Enable it with: git config core.hooksPath <path to this folder>
# On Linux and macOS the file needs the executable bit: chmod +x <path>/commit-msg
here=$(CDPATH="" cd -- "$(dirname -- "$0")" && pwd) || exit 1
if ! command -v node >/dev/null 2>&1; then
  echo "git-conventions: node not found, commit message not checked" >&2
  exit 0
fi
merge=""
merge_head=$(git rev-parse --git-path MERGE_HEAD 2>/dev/null) || merge_head=""
if [ -n "$merge_head" ] && [ -f "$merge_head" ]; then
  merge="--merge"
fi
# $merge is empty or one flag, so it stays unquoted
exec node "$here/../cli.mjs" commit-msg "$1" $merge
